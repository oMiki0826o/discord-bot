# 複製本檔案為 .env，並填入實際的值。
# 對應的讀取邏輯在 config.py，變數名稱需完全一致（大小寫需相符）。

# ── Discord（必要） ──────────────────────
DISCORD_TOKEN=你的_Discord_Bot_Token

# ── Google Gemini（選填，缺少時 AI 對話與摘要功能會停用） ──────────────────────
GEMINI_API=你的_Google_Gemini_API_Key

# ── Bot 擁有者（選填，預設 0；設定後才能使用 Owner 專用指令與私訊轉發） ──────────────────────
OWNER_ID=你的_Discord_使用者_ID

# ── 資料庫路徑（選填，預設 database/ai/memory.db） ──────────────────────
DB_PATH=database/ai/memory.db

# ── 以下為進階設定，一般情況不需要修改 ──────────────────────
# EXTENSION_PACKAGES=cogs
# EXTENSION_BLACKLIST=
# EXCLUDED_DIRS=__pycache__,venv,.venv
